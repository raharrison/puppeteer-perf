name: Performance Tests

on:
  push:
    branches: [master]
  pull_request:
    branches: [master]
  workflow_dispatch:

jobs:
  perf:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6

      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: npm

      - run: npm ci

      - name: Run performance tests
        run: npm test

      - name: Upload reports
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: perf-reports
          path: generated/
          retention-days: 30
